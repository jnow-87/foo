#ifndef I2C_DTS
#define I2C_DTS


/* macros */
// i2c bus device
#define i2c_bus(name, clk_khz, addr, int_num, ...) \
	i2cbus ##name = { \
		compatible = "i2c"; \
		\
		/* i2c driver config (i2c_cfg_t) */ \
		int16 = clk_khz; \
		int8 = addr; \
		int8 = int_num; \
		\
		/* childs */ \
		__VA_ARGS__ \
	}

// i2c raw device
#define i2c_raw(name) \
	i2craw ##name = { \
		compatible = "i2c,raw"; \
	}


#endif // I2C_DTS
