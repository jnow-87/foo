typedef{
	string compatible = "";

	int16 i[3] = [1, 2, 3];
	addr p[2] = [1, 2];
} type;

typedef{
	string compatible = "";

	addr p[3];
} donor;


// error-string: incompatible types string and int16
v = type(i="foo");

// error-string: mixing array and non-array types
v = type(i=1);

// error-string: integer 65536 out of int16 range (limit=65535)
v = type(i=[0, 65536, 0]);

// error-string: incompatible array sizes 2 and 1
v = type(p=[0]);

d = donor(p=[1, 2, 3]);

// error-string: incompatible array sizes 2 and 3
v = type(p=d.p);
