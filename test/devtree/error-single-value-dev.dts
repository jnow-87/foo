typedef{
	string compatible = "";

	int8 i;
} type;


// error-string: i: attribute already defined
v = type(i = 10, i = 20);

// error-string: incompatible types string and int8
v = type(i="foo");

// error-string: incompatible types int64 and string
v = type(i=1 + "f");

// error-string: integer 256 out of int8 range (limit=255)
v = type(i=256);
